<!-- Окно «Миграция баз» (1.0.0.51, issue #41, Avalonia/Linux).
     Windows-аналог: Views/ClusterMigrationWindow.xaml. Раскладка повторяет его:
     напоминание о количестве баз, выбор сервера назначения из справочника «Серверы 1С»
     (БЕЗ сервера-источника) и его кластера, учётные данные СУБД, галочка «Не удалять
     в старом», прогресс «N из M: база» и кнопки «Перенести»/«Отмена». Вся логика —
     в чистой ClusterMigrationViewModel; кнопки строит код за разметкой в хостах
     (паттерн BaseSelectionWindow.axaml). -->
<local:ModalWindowBase xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="clr-namespace:Workspace1C"
                       xmlns:loc="clr-namespace:Workspace1C.Localization"
                       x:Class="Workspace1C.ClusterMigrationWindow"
                       Title="{loc:Loc ClusterMigration.Title}"
                       Width="620" Height="430"
                       MinWidth="560" MinHeight="400"
                       FontSize="13"
                       CanResize="False">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

        <!-- Напоминание о количестве баз к переносу (issue #41). -->
        <TextBlock x:Name="BaseCountText" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <!-- Сервер 1С назначения: список БЕЗ сервера-источника; при выборе загружаются кластеры. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc ClusterMigration.TargetServer}" VerticalAlignment="Center"/>
            <ComboBox x:Name="ServerCombo" Width="360" VerticalContentAlignment="Center" Padding="6,2"/>
            <TextBlock x:Name="ServersEmptyHint" Text="{loc:Loc ClusterMigration.Error.ServersEmpty}"
                       FontSize="12" Opacity="0.65" TextWrapping="Wrap" MaxWidth="180"
                       VerticalAlignment="Center" IsVisible="False"/>
        </StackPanel>

        <!-- Кластер назначения + статус загрузки кластеров. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc ClusterMigration.TargetCluster}" VerticalAlignment="Center"/>
            <ComboBox x:Name="ClusterCombo" Width="360" VerticalContentAlignment="Center" Padding="6,2"/>
            <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.65" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Учётные данные СУБД (для добавления баз в новый кластер). -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,*" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc ClusterMigration.DbUser}" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="DbUserBox" Grid.Column="1" Padding="6,4"
                     VerticalContentAlignment="Center"
                     Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2" Text="{loc:Loc ClusterMigration.DbPassword}"
                       VerticalAlignment="Center" Margin="14,0,8,0"/>
            <TextBox x:Name="DbPasswordBox" Grid.Column="3" Padding="6,4"
                      PasswordChar="•" VerticalContentAlignment="Center"/>
        </Grid>

        <!-- «Не удалять в старом»: копия в другой кластер без удаления из источника. -->
        <CheckBox x:Name="KeepInSourceCheck" Grid.Row="4" VerticalAlignment="Center"
                  Content="{loc:Loc ClusterMigration.KeepInSource}"/>

        <!-- Прогресс «N из M: база» + сообщение об ошибке. -->
        <StackPanel Grid.Row="5" Margin="0,10,0,0" Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="ProgressText" FontSize="12" Opacity="0.65"
                           VerticalAlignment="Center"/>
                <ProgressBar x:Name="BusyProgress" Grid.Column="1" Width="120" Height="4"
                             IsIndeterminate="True" Foreground="#06B6D4"
                             VerticalAlignment="Center" IsVisible="False"/>
            </Grid>
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#DC2626" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Действия: «Перенести» (зелёная, как «Импортировать» в окне импорта) и «Отмена». -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <ContentControl x:Name="MigrateHost" VerticalAlignment="Center"/>
            <ContentControl x:Name="CancelHost" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</local:ModalWindowBase>
