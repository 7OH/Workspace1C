<Window x:Class="Workspace1C.ServiceGroupPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="{loc:Loc Services.GroupPicker.Title}"
        Width="400" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource ContentBackgroundBrush}">

    <!-- Диалог «Перенести в группу» окна «Управление службами» (issue #11, 1.0.0.14):
         выбор места для службы — «Без группы» (корневой список) или одна из групп. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="QuestionText" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <RadioButton x:Name="NoGroupRadio" GroupName="Target" VerticalContentAlignment="Center">
            <TextBlock Text="{loc:Loc Services.GroupPicker.NoGroup}"/>
        </RadioButton>

        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,0,-4,0">
            <StackPanel x:Name="GroupHost" Margin="0,0,4,0"/>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Common.Ok}" Width="92" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource AccentBrush}" Padding="14,6"
                    Margin="0,0,8,0" IsDefault="True" Click="OnOk_Click"/>
            <Button Content="{loc:Loc Common.Cancel}" Width="92" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="14,6"
                    IsCancel="True" Click="OnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>