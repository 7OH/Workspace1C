<!-- Окно «Миграция баз» (1.0.0.51, issue #41, Windows/WPF): перенос информационных баз
     из кластера-источника (открыто окно «Импорт из кластера 1С») в выбранный кластер
     другого сервера 1С. Выбор сервера назначения — из справочника «Серверы 1С» БЕЗ
     сервера-источника; при выборе сервера загружается список его кластеров (единственный
     выбирается автоматически). Напоминание о количестве баз к переносу, учётные данные
     СУБД (rac db-user/db-pwd, пароль только в памяти окна), галочка «Не удалять
     в старом» (копия без удаления) и кнопки «Перенести»/«Отмена». Фоном — прогресс
     «N из M: база». Вся логика — в чистой ClusterMigrationViewModel; окно — тонкая обёртка
     (источник серверов, подстановка выбранного сервера, вопрос о замене строки
     подключения после успешного переноса). -->
<Window x:Class="Workspace1C.ClusterMigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Height="430" Width="620" MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Напоминание о количестве баз к переносу (issue #41). -->
        <TextBlock x:Name="BaseCountText" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <!-- Сервер 1С назначения: список БЕЗ сервера-источника; при выборе загружаются кластеры. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc ClusterMigration.TargetServer}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ServerCombo" Width="360" Style="{StaticResource ModernComboBox}"
                      ItemsSource="{Binding AvailableServers}"
                      SelectedItem="{Binding SelectedServer}"
                      VerticalContentAlignment="Center" Padding="6,2">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Description}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock VerticalAlignment="Center" Opacity="0.6" Margin="6,0,0,0">
                                <Run Text="{Binding Address, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding Port, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="ServersEmptyHint" MaxWidth="180" VerticalAlignment="Center" Margin="10,0,0,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="{loc:Loc ClusterMigration.Error.ServersEmpty}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAvailableServers}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Кластер назначения + статус загрузки кластеров. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc ClusterMigration.TargetCluster}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ClusterCombo" Width="360" Style="{StaticResource ModernComboBox}"
                      ItemsSource="{Binding Clusters}" SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedClusterId}"
                      VerticalContentAlignment="Center" Padding="6,2">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Port, StringFormat=' [{0}]'}" Opacity="0.6"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding StatusText}"/>
        </StackPanel>

        <!-- Учётные данные СУБД (для добавления баз в новый кластер). -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Loc ClusterMigration.DbUser}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="DbUserBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                     Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
            <TextBlock Grid.Column="2" Text="{loc:Loc ClusterMigration.DbPassword}" VerticalAlignment="Center"
                       Margin="14,0,8,0"/>
            <!-- Пароль: без ModernTextBox — он имеет TargetType=TextBox и несовместим
                 с PasswordBox (см. комментарий в ProfilesPanel.xaml); PasswordBox получает
                 темированный implicit-стиль из LightTheme/DarkTheme. -->
            <PasswordBox x:Name="DbPasswordBox" Grid.Column="3" Padding="6,4"
                         PasswordChanged="OnDbPasswordChanged"/>
        </Grid>

        <!-- «Не удалять в старом»: копия в другой кластер без удаления из источника. -->
        <CheckBox x:Name="KeepInSourceCheck" Grid.Row="4" VerticalAlignment="Center"
                  Content="{loc:Loc ClusterMigration.KeepInSource}"
                  IsChecked="{Binding KeepInSource}"/>

        <!-- Прогресс «N из M: база» + сообщение об ошибке. -->
        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ProgressText" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ProgressBar Grid.Column="1" x:Name="BusyProgress" Width="120" Height="4"
                             IsIndeterminate="True" Visibility="Collapsed" Foreground="#06B6D4"
                             VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#DC2626" TextWrapping="Wrap"
                       Margin="0,6,0,0" Text="{Binding ErrorMessage}"/>
        </StackPanel>

        <!-- Действия: «Перенести» (зелёная, как «Импортировать» в окне импорта) и «Отмена». -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="MigrateButton" Style="{StaticResource ModernButton}"
                    Background="#16A34A" Foreground="White" Padding="16,5"
                    Click="OnMigrate_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➜" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                    <TextBlock Text="{loc:Loc ClusterMigration.MigrateButton}" VerticalAlignment="Center" Foreground="White"/>
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Style="{StaticResource ModernButton}" IsCancel="True"
                    Background="{DynamicResource ItemHoverBrush}" Padding="14,5" Margin="10,0,0,0"
                    Click="OnCancel_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
